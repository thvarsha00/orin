import { useState } from "react";
import { LanguageSelect } from "../components/LanguageSelect";
import { ScriptSelect } from "../components/ScriptSelect";
import { useAuth } from "../context/AuthContext";
import type { Level } from "../types";

export default function Settings() {
  const { user, updateProfile } = useAuth();
  const [msg, setMsg] = useState("");
  if (!user) return null;

  const save = async (patch: Parameters<typeof updateProfile>[0]) => {
    try { await updateProfile(patch); setMsg("Saved"); } catch (e) { setMsg((e as Error).message); }
  };

  return (
    <div className="mx-auto max-w-xl space-y-6 p-6 md:p-10">
      <h1 className="text-2xl font-semibold">Settings</h1>
      <div className="space-y-2"><p className="text-sm text-slate-400">Preferred language</p>
        <LanguageSelect value={user.profile.preferred_language} onChange={(l) => save({ preferred_language: l })} /></div>
      {user.profile.preferred_language !== "en" && (
        <div className="space-y-2"><p className="text-sm text-slate-400">How should Orin write your language?</p>
          <ScriptSelect value={user.profile.preferred_script} onChange={(v) => save({ preferred_script: v })} /></div>
      )}
      <div className="space-y-2"><p className="text-sm text-slate-400">Skill level</p>
        <select value={user.profile.skill_level} onChange={(e) => save({ skill_level: e.target.value as Level })}
          className="rounded-md border border-line bg-panel px-2 py-1.5 text-sm">
          <option value="beginner">Beginner</option><option value="intermediate">Intermediate</option><option value="advanced">Advanced</option>
        </select></div>
      {msg && <p className="text-sm text-accent2">{msg}</p>}
    </div>
  );
}

  value: number;
  label: string;
  valueClass?: string;
}) {
  return (
    <div className="flex items-center gap-3 border-b border-white/[0.06] px-4 py-4 last:border-b-0 sm:border-b-0 sm:border-r sm:last:border-r-0">

const DIFFICULTY_ORDER: Record<string, number> = {
  easy: 0,
  medium: 1,
  hard: 2,
};

function splitIntoLevels(
  problems: ProblemSummary[],
) {
  const sorted = [...problems].sort((a, b) => {
    const difficultyDifference =
      (DIFFICULTY_ORDER[a.difficulty] ?? 99) -
      (DIFFICULTY_ORDER[b.difficulty] ?? 99);

    if (difficultyDifference !== 0) {
      return difficultyDifference;
    }

    return a.id - b.id;
  });

  return LEVELS.map((level, index) => ({
    ...level,
    problems: sorted.slice(
      index * 10,
      index * 10 + 10,
    ),
  }));
}

function difficultyText(
  difficulty: string,
) {
  if (difficulty === "hard") {
    return "text-red-400";
  }

  if (difficulty === "medium") {
    return "text-amber-400";
  }

  return "text-emerald-400";
}

function difficultyDot(
  difficulty: string,
) {
  if (difficulty === "hard") {
    return "bg-red-400";
  }

  if (difficulty === "medium") {
    return "bg-amber-400";
  }

  return "bg-emerald-400";
}

function difficultyLabel(
  difficulty: string,
) {
  return (
    difficulty.charAt(0).toUpperCase() +
    difficulty.slice(1)
  );
}

export default function Code() {
  const [language, setLanguage] =
    useState<CodingLanguage | null>(null);

  const [problems, setProblems] =
    useState<ProblemSummary[] | null>(null);

  const [progress, setProgress] =
    useState<CodingProgress | null>(null);

  const [selectedLevel, setSelectedLevel] =
    useState<number | null>(null);

  const [search, setSearch] =
    useState("");

  const [error, setError] = useState("");

  useEffect(() => {
    if (!language) {
      setProblems(null);
      setProgress(null);
      setSelectedLevel(null);
      setError("");
      return;
    }

    let cancelled = false;

    setProblems(null);
    setProgress(null);
    setSelectedLevel(null);
    setError("");

    Promise.all([
      listProblems(language),
      getCodingProgress(),
    ])
      .then(([items, progressData]) => {
        if (cancelled) {
          return;
        }

        setProblems(items);
        setProgress(progressData);
      })
      .catch((e: Error) => {
        if (!cancelled) {
          setError(e.message);
        }
      });

    return () => {
      cancelled = true;
    };
  }, [language]);

  const levels = useMemo(
    () => splitIntoLevels(problems ?? []),
    [problems],
  );


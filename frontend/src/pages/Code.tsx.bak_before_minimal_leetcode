    const query = search.trim().toLowerCase();

    if (!query) {
      return levels;
    }

    return levels
      .map((level) => ({
        ...level,
        problems: level.problems.filter(
          (problem) =>
            problem.title
              .toLowerCase()
              .includes(query) ||
            problem.topic
              .toLowerCase()
              .includes(query) ||
            problem.difficulty
              .toLowerCase()
              .includes(query),
        ),
      }))
      .filter(
        (level) => level.problems.length > 0,
      );
  }, [levels, search]);


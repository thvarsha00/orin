    () => ({
      easy: (problems ?? []).filter(
        (problem) =>
          problem.difficulty === "easy",
      ).length,
      medium: (problems ?? []).filter(
        (problem) =>
          problem.difficulty === "medium",
      ).length,
      hard: (problems ?? []).filter(
        (problem) =>
          problem.difficulty === "hard",
      ).length,
    }),
    [problems],
  );

  /*
   * LANGUAGE SELECTION
   */


          {/* Header */}
          <div className="border-b border-white/[0.07] pb-5">
            <div className="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
              <div>
                <div className="flex items-center gap-2 text-xs text-slate-600">
                  <span>Orin</span>
                  <ChevronRight size={12} />
                  <span className="text-slate-400">
                    Code
                  </span>
                </div>

                <h1 className="mt-3 text-3xl font-bold tracking-tight text-white">
                  Orin Code
                </h1>

                <p className="mt-2 max-w-xl text-sm leading-6 text-slate-500">
                  Solve real coding problems, sharpen
                  your skills, and build stronger
                  problem-solving instincts.
                </p>
              </div>

              <button
                type="button"
                onClick={() =>
                  setLanguage(null)
                }
                className="flex h-10 items-center gap-3 self-start rounded-lg border border-white/10 bg-panel px-3 text-sm text-slate-300 hover:border-white/20 hover:text-white lg:self-auto"
              >
                <span className="flex h-6 w-6 items-center justify-center rounded bg-white/[0.06] font-mono text-[10px] font-bold text-accent">
                  {selectedLanguage?.shortName}
                </span>

                {selectedLanguage?.name}

                <ChevronDown
                  size={14}
                  className="ml-2 text-slate-600"
                />
              </button>
            </div>
          </div>

          {/* Stats */}
          <div className="mt-5 grid overflow-hidden rounded-xl border border-white/[0.07] bg-panel sm:grid-cols-4">
            <Stat
              icon={TerminalSquare}
              value={problems.length}
              label="Total Problems"
            />

            <Stat
              value={difficultyCounts.easy}
              label="Easy"
              valueClass="text-emerald-400"
            />

            <Stat
              value={difficultyCounts.medium}
              label="Medium"
              valueClass="text-amber-400"
            />

            <Stat
              value={difficultyCounts.hard}
              label="Hard"
              valueClass="text-red-400"
            />
          </div>

          {/* Search */}
          <div className="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p className="text-xs font-semibold uppercase tracking-[0.16em] text-slate-600">
                Problem Sets
              </p>

              <p className="mt-1 text-xs text-slate-600">
                {levels.length} levels ·{" "}
                {problems.length} problems
              </p>
            </div>

            <div className="relative w-full sm:w-72">
              <Search
                size={15}
                className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-600"
              />

              <input
                value={search}
                onChange={(event) =>
                  setSearch(event.target.value)
                }
                placeholder="Search problems..."
                className="h-9 w-full rounded-lg border border-white/10 bg-panel pl-9 pr-3 text-xs text-slate-300 outline-none placeholder:text-slate-700 focus:border-accent/30"
              />
            </div>
          </div>

          {/* Problem sets */}
          <div className="mt-3 overflow-hidden rounded-xl border border-white/[0.07] bg-panel">
            {filteredLevels.length === 0 ? (
              <div className="p-10 text-center">
                <p className="text-sm text-slate-500">
                  No problems match your search.
                </p>
              </div>
            ) : (
              filteredLevels.map(
                (level, index) => (
                  <button
                    key={level.number}
                    type="button"
                    onClick={() =>
                      setSelectedLevel(
                        levels.findIndex(
                          (item) =>
                            item.number ===
                            level.number,
                        ),
                      )
                    }
                    className="group flex w-full items-center gap-4 border-b border-white/[0.05] px-4 py-4 text-left last:border-b-0 hover:bg-white/[0.025] md:px-5"
                  >
                    <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white/[0.035] font-mono text-xs font-semibold text-slate-500 group-hover:bg-accent/10 group-hover:text-accent">
                      {String(
                        level.number,
                      ).padStart(2, "0")}
                    </div>

                    <div className="min-w-0 flex-1">
                      <div className="flex items-center gap-2">
                        <h3 className="truncate text-sm font-semibold text-slate-300 group-hover:text-white">
                          {level.title}
                        </h3>

                        <span
                          className={`hidden text-[10px] font-medium sm:inline ${difficultyText(
                            level.difficulty,
                          )}`}
                        >
                          {difficultyLabel(
                            level.difficulty,
                          )}
                        </span>
                      </div>

                      <p className="mt-1 truncate text-xs text-slate-600">
                        {level.description}
                      </p>
                    </div>

                    <div className="hidden text-right sm:block">
                      <p className="text-xs font-medium text-slate-400">
                        {level.problems.length}
                      </p>

                      <p className="text-[9px] uppercase tracking-widest text-slate-700">
                        problems
                      </p>
                    </div>

                    <ChevronRight
                      size={16}
                      className="shrink-0 text-slate-700 group-hover:translate-x-1 group-hover:text-slate-300"
                    />
                  </button>

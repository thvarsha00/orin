                    <ChevronRight
                      size={13}
                      className="text-slate-700 group-hover:text-slate-400"
                    />
                  </button>
                ),
              )}
            </div>

            {levels.length > 6 && (
              <button
                type="button"
                onClick={() =>
                  setSelectedLevel(6)
                }
                className="mt-3 w-full border-t border-white/[0.06] pt-3 text-left text-[11px] font-medium text-accent hover:text-accent2"
              >
                View all problem sets →
              </button>
            )}
          </div>
        </aside>
      </div>
    </div>
  );
}


{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "orin-frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "orin-api": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "orin-api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "orin-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "orin-frontend"
      }
    }
  ]
}
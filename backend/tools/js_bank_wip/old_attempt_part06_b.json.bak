  {
    "title": "Serialize and Deserialize Binary Tree",
    "topic": "JavaScript Trees",
    "difficulty": "hard",
    "description": "Given a binary tree represented as a level-order array where null represents a missing child, serialize the tree and then deserialize it. Return the resulting tree in the same normalized level-order array representation.",
    "examples": [
      {
        "input": [[1, 2, 3, null, null, 4, 5]],
        "output": [1, 2, 3, null, null, 4, 5]
      },
      {
        "input": [[1, 2, null, 3]],
        "output": [1, 2, null, 3]
      },
      {
        "input": [[7]],
        "output": [7]
      }
    ],
    "constraints": "The input represents a valid binary tree in level-order form. Values are integers or null. The tree contains at most 100000 nodes.",
    "starter_code": "function solve(values) {\n    // write your code here\n}",
    "entry_function": "solve",
    "expected_complexity": "O(n) time and O(n) space",
    "tags": [
      "trees",
      "serialization",
      "deserialization",
      "level-order"
    ],
    "hints": [
      "Use a queue to reconstruct the tree from the level-order representation.",
      "Preserve null children while traversing the tree.",
      "Remove only trailing null values from the final level-order representation."
    ],
    "reference_solution": "function solve(values) {\n    if (!values || values.length === 0 || values[0] === null) return [];\n\n    const root = { value: values[0], left: null, right: null };\n    const queue = [root];\n    let head = 0;\n    let index = 1;\n\n    while (head < queue.length && index < values.length) {\n        const node = queue[head++];\n\n        if (index < values.length && values[index] !== null) {\n            node.left = { value: values[index], left: null, right: null };\n            queue.push(node.left);\n        }\n        index++;\n\n        if (index < values.length && values[index] !== null) {\n            node.right = { value: values[index], left: null, right: null };\n            queue.push(node.right);\n        }\n        index++;\n    }\n\n    const result = [];\n    const traversal = [root];\n    let traversalHead = 0;\n\n    while (traversalHead < traversal.length) {\n        const node = traversal[traversalHead++];\n        if (node === null) {\n            result.push(null);\n        } else {\n            result.push(node.value);\n            traversal.push(node.left);\n            traversal.push(node.right);\n        }\n    }\n\n    while (result.length > 0 && result[result.length - 1] === null) {\n        result.pop();\n    }\n\n    return result;\n}",
    "tests": [
      {
        "input": [[1, 2, 3, null, null, 4, 5]],
        "output": [1, 2, 3, null, null, 4, 5],
        "hidden": false
      },
      {
        "input": [[1, 2, null, 3]],
        "output": [1, 2, null, 3],
        "hidden": false
      },
      {
        "input": [[7]],
        "output": [7],
        "hidden": true
      },
      {
        "input": [[10, 5, 15, 2, 7, null, 20]],
        "output": [10, 5, 15, 2, 7, null, 20],
        "hidden": true
      }
    ]
  }

        "output": 1
      }
    ],
    "constraints": "The array contains n + 1 integers with values from 1 through n. There is exactly one duplicated value.",
    "starter_code": "function solve(nums) {\n    // write your code here\n}",
    "entry_function": "solve",
    "expected_complexity": "O(n) time and O(1) extra space",
    "tags": [
      "two-pointers",
      "cycle-detection",
      "arrays"
    ],
    "hints": [
      "Treat each value as a pointer to another index.",
      "The duplicate creates a cycle.",
      "Use Floyd's tortoise and hare cycle detection."
    ],
    "reference_solution": "function solve(nums) {\n    let slow = nums[0];\n    let fast = nums[0];\n\n    do {\n        slow = nums[slow];\n        fast = nums[nums[fast]];\n    } while (slow !== fast);\n\n    slow = nums[0];\n    while (slow !== fast) {\n        slow = nums[slow];\n        fast = nums[fast];\n    }\n\n    return slow;\n}",

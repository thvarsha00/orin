# --- AI provider: groq | xai | ollama ---
AI_PROVIDER=groq

# Groq (console.groq.com -> API Keys -> Create API Key)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# xAI Grok (console.x.ai) - only if AI_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Ollama (local, free) - only if AI_PROVIDER=ollama, and used for RAG embeddings later
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3

# --- Image understanding (vision) ---
# Text-only chat keeps using the models above. Chats with an attached image use a vision model.
# VISION_PROVIDER blank = same provider as AI_PROVIDER.
VISION_PROVIDER=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
XAI_VISION_MODEL=
OLLAMA_VISION_MODEL=
MAX_IMAGE_MB=4
UPLOAD_DIR=./uploads

# --- Documents + RAG ---
# Embeddings use OLLAMA_EMBED_MODEL above (run: ollama pull bge-m3) even when chat uses Groq.
MAX_DOC_MB=25
RAG_TOP_K=6
RAG_MIN_SCORE=0.30

DATABASE_URL=sqlite:///./orin.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
